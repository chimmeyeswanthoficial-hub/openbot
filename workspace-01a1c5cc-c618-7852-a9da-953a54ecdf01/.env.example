# Copy to .env and fill in. .env is git-ignored; never commit real values.
# `make verify` warns (does not fail) while any value is still a placeholder.

# --- Sentinel (services/sentinel) -------------------------------------------
# Where the audit trail, approvals and ledger rows live.
#   sqlite: .openbot/state/openbot.db   |   postgres: postgresql://user:pass@host/db
SENTINEL_DB=.openbot/state/openbot.db
# Gate for writes (approvals, ledger). Empty on loopback = open (make demo);
# a public address MUST set this. Generate: openssl rand -hex 24
SENTINEL_UI_TOKEN=
# 0.0.0.0 so the platform preview can reach it; 127.0.0.1 for a private box.
SENTINEL_HOST=0.0.0.0
SENTINEL_PORT=8090

# --- OpenBot substrate (repos/OpenBot) --------------------------------------
# Required by the substrate's server; generate both and store them somewhere safe.
KEY_ENCRYPTION_KEY=
BOT_TOKEN_SECRET=
# One model key is enough to start. Which one is set decides the provider.
# --- freellmapi (local unified LLM proxy on port 31415) ---
# Install: npx freellmapi setup-claude --url http://127.0.0.1:31415
# Key:     freellmapi-c0e640e2ad229ee8bef49e4d0798c673c5b479bf2108cd03
# This proxy routes to OpenAI / Anthropic / Gemini transparently.
BOT_PROVIDER=openai
OPENAI_API_BASE=http://127.0.0.1:31415/v1
OPENAI_API_KEY=freellmapi-c0e640e2ad229ee8bef49e4d0798c673c5b479bf2108cd03
# --- OR: direct provider keys (comment out the freellmapi lines above) ---
# BOT_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# CopilotKit Intelligence project (npx copilotkit login && npx copilotkit project select)
INTELLIGENCE_API_KEY=
INTELLIGENCE_PROJECT_ID=

# --- Worker (services/worker) -----------------------------------------------
WORKER_TICK_SECONDS=60
WORKER_SENTINEL_URL=http://127.0.0.1:8090
WORKER_LOG_LEVEL=INFO

# --- Payment provider (test mode needs no legal entity) ---------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Watchdog ---------------------------------------------------------------
# A URL that is NOT this box. If we die, somebody else must notice.
DEADMAN_PING_URL=
